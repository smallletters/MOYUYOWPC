{
  "name" : "MOYUYO-Auth",
  "id" : "MOYUYO-Auth",
  "version" : "1.0.0",
  "description" : "MOYUYO 社交登录（Google / Facebook / Apple）",
  "_dp_type" : "nativeplugin",
  "_dp_nativeplugin" : {
    "android" : {
      "plugins" : [
        {
          "type" : "module",
          "name" : "MOYUYO-Auth",
          "class" : "com.moyuyo.plugin.auth.AuthModule"
        }
      ],
      "integrateType" : "aar",
      "minSdkVersion" : 24,
      "dependencies" : [
        "com.google.android.gms:play-services-auth:20.7.0",
        "com.facebook.android:facebook-login:16.2.0"
      ]
    },
    "ios" : {
      "plugins" : [
        {
          "type" : "module",
          "name" : "MOYUYO-Auth",
          "class" : "AuthModule"
        }
      ],
      "integrateType" : "framework",
      "deploymentTarget" : "12.0",
      "frameworks" : [ "AuthenticationServices.framework" ]
    }
  }
}
