{
  "name" : "MOYUYO-SecureStorage",
  "id" : "MOYUYO-SecureStorage",
  "version" : "1.0.0",
  "description" : "MOYUYO 凭证加密存储（Android EncryptedSharedPreferences / iOS Keychain）",
  "_dp_type" : "nativeplugin",
  "_dp_nativeplugin" : {
    "android" : {
      "plugins" : [
        {
          "type" : "module",
          "name" : "MOYUYO-SecureStorage",
          "class" : "com.moyuyo.plugin.secure.SecureStorageModule"
        }
      ],
      "integrateType" : "aar",
      "minSdkVersion" : 24,
      "dependencies" : [ "androidx.security:security-crypto:1.1.0-alpha06" ]
    },
    "ios" : {
      "plugins" : [
        {
          "type" : "module",
          "name" : "MOYUYO-SecureStorage",
          "class" : "SecureStorageModule"
        }
      ],
      "integrateType" : "framework",
      "deploymentTarget" : "12.0",
      "frameworks" : [ "Security.framework" ]
    }
  }
}
