# ========================================
# MOYUYO ATELIER - Vite Development Mode
# 对应命令：npm run dev:h5  /  npm run dev:mp-weixin
# 生效方式：Vite mode=development 时自动读取，并覆盖基础 .env 中同名字段
# ========================================
# 安全说明：本文件所有 VITE_ 变量都会注入到浏览器 JS bundle，严禁放私钥 / 密码。
#          本地调试无需提交 Git 的个性化覆盖可写在 .env.development.local（已 .gitignore）。

# ===== MOYUYO 自研后端（Spring Boot，本地端口 8080） =====
# H5 本地开发：留空，所有 /api/v1/* 请求由 vite.config.js 的 proxy 转发到 http://localhost:8080
#             这样无需配置 CORS，天然同源。
# APP 端真机调试：填局域网 IP，例如 http://192.168.6.103:8080
# 注意：自定义基座运行走的是 dev build，会读本文件；
#      云打包（发行 → 原生 APP-云打包）走的是 prod build，会读 .env.production
VITE_ADMIN_API_BASE=http://192.168.6.103:8080

# ===== WordPress / WooCommerce（可选，仅在 C 端商品走 WP 时启用） =====
# 开发阶段未接入 WP 时保留占位值即可，登录/注册链路不依赖。
VITE_API_BASE=https://your-wp-site.com/wp-json
VITE_WP_BASE=https://your-wp-site.com
VITE_CONSUMER_KEY=your_consumer_key_here
VITE_CONSUMER_SECRET=your_consumer_secret_here

# ===== WP OAuth Server（MiniOrange，可选） =====
VITE_OAUTH_CLIENT_ID=your_oauth_client_id
VITE_OAUTH_CLIENT_SECRET=your_oauth_client_secret

# ===== 结算货币（开发默认 CNY，方便用 ¥ 视觉校验；生产请用 USD） =====
VITE_CURRENCY=CNY

# ===== 主题模式：light / dark / system =====
VITE_THEME_MODE=light

# ===== 默认区号：开发沿用 +86（方便中国开发者用自己手机号收码）=====
VITE_DEFAULT_COUNTRY_CODE=+86

# ===== 默认语言：开发沿用 zh-CN，方便看中文文案 i18n 对不对 =====
VITE_DEFAULT_LOCALE=zh-CN

# ===== APP 品牌标题（两端通用，这里也可覆盖成 DEV-SUFFIX 便于区分） =====
VITE_APP_TITLE=MOYUYO DEV

# ===== 法定协议链接：开发留空，走内置兜底页；上线前替换真实法务页 =====
VITE_TERMS_URL=
VITE_PRIVACY_URL=
VITE_QUALIFICATION_URL=
VITE_LICENSE_URL=

# ===== 客服联系方式：开发用示例值，不影响登录链路 =====
VITE_CONTACT_WEBSITE=www.moyuyo.com
VITE_CONTACT_EMAIL=support@moyuyo.com
VITE_CONTACT_PHONE=400-888-MOYU

# ===== 社会化登录开关：开发一律关闭，避免 OAuth 回调未配置导致用户困惑 =====
VITE_SOCIAL_GOOGLE_ENABLED=false
VITE_SOCIAL_GOOGLE_URL=
VITE_SOCIAL_APPLE_ENABLED=false

# ===== WebView 白名单（防钓鱼外链跳转）：开发 + 生产域名都要列 =====
VITE_WEBVIEW_ALLOWED_HOSTS=localhost,127.0.0.1,moyuyo.com,www.moyuyo.com,api.moyuyo.com,192.168.6.103:5174,

# ===== 支付回跳绝对 URL base（开发 = Vite 本地域名，不能留空否则回跳 URI 校验失败） =====
VITE_PAY_RETURN_BASE=http://localhost:5174

# ===== Web Push VAPID 公钥（可选，未接入留空） =====
VITE_PUSH_VAPID_PUBLIC_KEY=
