# ============================================
# MOYUYO APP - 生产环境配置
# 使用方式：npm run build:h5 / build:app
# ⚠️ 提交到 Git 前请确认：
#   1) 所有 VITE_CONSUMER_* 都是 prod 专用（绝不能用 ck_test_*）
#   2) 所有 URL 都是 https://
#   3) 域名替换为 moyuyoshop.com 真实域名
#   4) VITE_* 变量会打包进客户端 bundle，请勿填入高敏感凭证
#      （如需 Server 端密钥，请走后端代理，参考 moyuyo-server/.env.example）
# ============================================

# ---- 后端 API（必填，绝对 https 地址）----
VITE_ADMIN_API_BASE=https://api.moyuyoshop.com

# ---- WordPress / WooCommerce 站点 ----
VITE_WP_BASE=https://moyuyoshop.com
VITE_API_BASE=https://moyuyoshop.com/wp-json

# WooCommerce 生产凭证（CI/CD 用 Secrets 注入，不进 Git）
# 权限必须最小化：勾选 Read 即可，禁止 Write/Admin
VITE_CONSUMER_KEY=REPLACE_WITH_PROD_CK
VITE_CONSUMER_SECRET=REPLACE_WITH_PROD_CS

# ---- WordPress OAuth ----
VITE_OAUTH_CLIENT_ID=REPLACE_WITH_PROD_OAUTH_CLIENT_ID
VITE_OAUTH_CLIENT_SECRET=REPLACE_WITH_PROD_OAUTH_CLIENT_SECRET

# ---- 支付回跳域名（PayPal/Stripe returnUrl 必须 https）----
VITE_PAY_RETURN_BASE=https://moyuyoshop.com

# ---- 主题 / 货币 ----
VITE_CURRENCY=CNY
VITE_THEME_MODE=system

# ---- 法定协议链接（法务/产品上线前替换为正式 URL）----
VITE_TERMS_URL=https://moyuyoshop.com/terms
VITE_PRIVACY_URL=https://moyuyoshop.com/privacy
VITE_QUALIFICATION_URL=https://moyuyoshop.com/qualification
VITE_LICENSE_URL=https://moyuyoshop.com/license

# ---- 客服联系方式 ----
VITE_CONTACT_WEBSITE=moyuyoshop.com
VITE_CONTACT_EMAIL=support@moyuyoshop.com
VITE_CONTACT_PHONE=400-888-MOYU

# ---- 第三方登录开关（启用前必须确保 OAuth 已对接）----
VITE_SOCIAL_GOOGLE_ENABLED=false
VITE_SOCIAL_APPLE_ENABLED=false
VITE_SOCIAL_GOOGLE_URL=

# ---- WebView 白名单（prod 真实域名，禁止 IP / localhost）----
VITE_WEBVIEW_ALLOWED_HOSTS=moyuyoshop.com,www.moyuyoshop.com,api.moyuyoshop.com
