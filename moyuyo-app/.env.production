# ========================================
# MOYUYO ATELIER - Vite Production Mode
# 对应命令：npm run build:h5  /  npm run build:mp-weixin
# 生效方式：Vite mode=production 时自动读取，并覆盖基础 .env 中同名字段
# ⚠️ 注意：VITE_* 变量是「构建期注入」——打包时写入 JS bundle 字面量。
#         部署服务器上改 .env 不会生效，必须重新 npm run build:h5。
# ========================================
# 安全说明：本文件所有 VITE_ 变量都会进入浏览器可访问的 bundle。
#          严禁写入任何 sk_ 私钥 / 密码 / 签名密钥；这些一律放后端 moyuyo-server/.env
#          任何带密钥属性的个性化覆盖写在 .env.production.local（已 .gitignore）。

# ===== MOYUYO 自研后端 =====
# 推荐模式 A（同源，最简单、无 CORS 问题）：留空
#   前端请求 /api/v1/* → Nginx location /api/ 反代到本机 Spring Boot 8080
# 模式 B（前后端独立域名）：填 https://api.moyuyo.com
#   此时需要后端 moyuyo-server/.env 的 MOYUYO_CORS_ORIGINS 放行 www.moyuyo.com
# 模式 C（真机调试，局域网直连后端）：填 http://你的电脑IP:8080
#   注意：手机必须和后端在同一局域网；iOS 14+ ATS 会拒绝 HTTP，需在 manifest.json
#         配置 app-plus.ios.exceptionDomains 或 ATS 白名单
VITE_ADMIN_API_BASE=http://192.168.6.103:8080

# ===== WordPress / WooCommerce（可选，未接入可保留占位值） =====
VITE_API_BASE=https://your-wp-site.com/wp-json
VITE_WP_BASE=https://your-wp-site.com
VITE_CONSUMER_KEY=your_consumer_key_here
VITE_CONSUMER_SECRET=your_consumer_secret_here

# ===== WP OAuth Server（MiniOrange，可选） =====
VITE_OAUTH_CLIENT_ID=your_oauth_client_id
VITE_OAUTH_CLIENT_SECRET=your_oauth_client_secret

# ===== 结算货币：美国市场 H5 = USD（登录页 / 购物车 / 结算页都会自动切换 $ 符号） =====
VITE_CURRENCY=USD

# ===== 主题模式：跟随系统，兼顾 iOS/Android 深色用户 =====
VITE_THEME_MODE=system

# ===== 默认区号：面向美国用户默认 +1 =====
VITE_DEFAULT_COUNTRY_CODE=+1

# ===== 默认语言：美国市场先英后中，登录页 Welcome Back 首屏英文 =====
VITE_DEFAULT_LOCALE=en-US

# ===== APP 品牌标题：生产不带 DEV 后缀 =====
VITE_APP_TITLE=MOYUYO

# ===== 法定协议链接：必须填写真实可访问的法务页面，否则登录页条款行点进去 404 =====
VITE_TERMS_URL=https://www.moyuyo.com/legal/terms
VITE_PRIVACY_URL=https://www.moyuyo.com/legal/privacy
VITE_QUALIFICATION_URL=https://www.moyuyo.com/legal/qualification
VITE_LICENSE_URL=https://www.moyuyo.com/legal/license

# ===== 客服联系方式：上线前必须替换为真实对外信息（美国 800 号优先） =====
VITE_CONTACT_WEBSITE=www.moyuyo.com
VITE_CONTACT_EMAIL=support@moyuyo.com
VITE_CONTACT_PHONE=+1-800-888-6698

# ===== 社会化登录开关：生产开启前确保后端 moyuyo-server 对应 Client ID / 回调已配好 =====
# 上线第一阶段先关闭，等 Google Cloud Console / Apple Developer 后台验证完成后再置 true
VITE_SOCIAL_GOOGLE_ENABLED=false
# 对应后端端点：OAuth code → 回调 → 服务端换 token → 建/查用户 → 签发自研 JWT
VITE_SOCIAL_GOOGLE_URL=https://api.moyuyo.com/api/v1/auth/social/google/callback
VITE_SOCIAL_APPLE_ENABLED=false

# ===== WebView 白名单：只放行自有域名，防止支付中转页被钓鱼开放重定向 =====
VITE_WEBVIEW_ALLOWED_HOSTS=moyuyo.com,www.moyuyo.com,api.moyuyo.com

# ===== 支付回跳绝对 URL base（PayPal/Stripe returnUrl/取消 cancelUrl 的前缀） =====
# ⚠️ 必须是用户浏览器实际可访问的域名，不能是内网 IP/localhost
VITE_PAY_RETURN_BASE=https://www.moyuyo.com

# ===== Web Push VAPID 公钥（可选，未接入留空） =====
VITE_PUSH_VAPID_PUBLIC_KEY=
