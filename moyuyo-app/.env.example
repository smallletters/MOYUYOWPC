# ========================================
# MOYUYO ATELIER 环境变量模板
# ========================================
# 复制本文件为 .env 并填写实际值：
#   cp .env.example .env
# 真实 .env 文件已在 .gitignore 中排除。
# ========================================

# API 基础地址（生产环境推荐填写 Cloudflare Workers 代理层）
VITE_API_BASE=https://your-wp-site.com/wp-json

# WordPress 站点地址（用于支付跳转、WebView 加载 WP 页面）
VITE_WP_BASE=https://your-wp-site.com

# WooCommerce REST API Consumer Key
VITE_CONSUMER_KEY=your_consumer_key_here

# WooCommerce REST API Consumer Secret
VITE_CONSUMER_SECRET=your_consumer_secret_here

# WP OAuth Server（MiniOrange）OAuth 凭证
# 在 WP 后台 → 插件 → 安装 "WP OAuth Server"
# WP OAuth Server → 客户端 → 添加客户端 → 创建 App → 获取 Client ID/Secret
VITE_OAUTH_CLIENT_ID=your_oauth_client_id
VITE_OAUTH_CLIENT_SECRET=your_oauth_client_secret

# 结算货币
VITE_CURRENCY=USD

# 主题模式：light / dark / system
VITE_THEME_MODE=system

# 法定协议链接（about 页展示用，留空则使用内置兜底页）
VITE_TERMS_URL=
VITE_PRIVACY_URL=
VITE_QUALIFICATION_URL=
VITE_LICENSE_URL=

# ============================================================
# 客服联系方式（about 页展示）
# 上线前必须改为真实号码/邮箱/官网
# ============================================================
VITE_CONTACT_WEBSITE=
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=

# ============================================================
# 社会化登录开关（true=显示按钮 false=隐藏）
# ============================================================
# Google OAuth Web Flow 接入指南：
#   1. Google Cloud Console → APIs & Services → Credentials → Create OAuth Client ID
#   2. Authorized redirect URIs 填入 https://your-domain.com/auth/google/callback
#   3. 后端实现 /api/v1/auth/social/google/callback 接口,用 code 换 access_token + profile
#   4. 把 Google 授权跳转 URL（你的后端入口）填到 VITE_SOCIAL_GOOGLE_URL
VITE_SOCIAL_GOOGLE_ENABLED=false
VITE_SOCIAL_GOOGLE_URL=

# Apple Sign In 需要：
#   1. Apple Developer 后台配置 Service ID + Return URL
#   2. 后端用 client_secret JWT 验证 Apple id_token
#   3. 启用后客户端通过 uni.login({ provider: 'apple' }) 调起原生 Sign In with Apple
VITE_SOCIAL_APPLE_ENABLED=false

# ============================================================
# WebView 白名单（防钓鱼外链）
# ============================================================
# 多个 host 用英文逗号分隔,支持子域名通配（如 *.moyuyo.com）
# 默认自动从 VITE_CONTACT_WEBSITE 派生 + your-wp-site.com
VITE_WEBVIEW_ALLOWED_HOSTS=

# ============================================================
# 部署相关（H5 构建时由 Vite 注入；务必按实际域名/反代填写）
# ============================================================

# MOYUYO 后端 API 域名（移动端离线包/独立部署时使用；同源反代可留空）
# 生产示例: https://api.moyuyo.com
VITE_ADMIN_API_BASE=

# 支付成功/取消回跳的绝对 URL base（必须填写 https://your-domain）
# dev 默认留空走 Vite proxy；prod 示例: https://www.moyuyo.com
VITE_PAY_RETURN_BASE=
