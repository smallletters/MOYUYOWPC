<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.moyuyo</groupId>
        <artifactId>moyuyo-server</artifactId>
        <version>1.0.0</version>
    </parent>
    <artifactId>moyuyo-service</artifactId>
    <name>MOYUYO Service</name>
    <description>业务逻辑层</description>

    <dependencies>
        <dependency>
            <groupId>com.moyuyo</groupId>
            <artifactId>moyuyo-dao</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- BCrypt 密码编码器：AuthServiceImpl / AdminStaffServiceImpl 等使用统一 PasswordEncoder Bean
             不再各自 new BCryptPasswordEncoder(12)，强度由 moyuyo.password.bcrypt-strength 控制 -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- Elasticsearch -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-elasticsearch</artifactId>
        </dependency>

        <!-- 测试依赖（JUnit 5 + AssertJ） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
