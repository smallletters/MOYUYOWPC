# ============================================
# MOYUYO 宠物商城 - 环境变量配置示例
# ⚠️ 安全警告（生产环境必读）：
#   1. 生产环境必须为每个变量使用强随机值，禁止使用本文件中的占位符
#   2. 本文件仅作模板参考，请勿直接复制到 .env 用于生产
#   3. .env 文件必须加入 .gitignore（已默认），禁止提交到 Git
#   4. MOYUYO_CORS_ORIGINS 禁止使用 *，必须明确列出允许的前端域名
#   5. ADMIN_PASSWORD 至少 12 位混合大小写+数字+特殊字符
#   6. JWT_SECRET 至少 32 字节随机串，建议 `openssl rand -base64 48` 生成
# ============================================

# ---- 数据库 ----
# MySQL root 密码仅供容器初始化和数据库运维使用，应用不得使用 root 连接
MYSQL_ROOT_PASSWORD=your_root_password_here_min_20_chars
MYSQL_DATABASE=moyuyo_prod
# MySQL 密码（生产环境必填，至少 16 位混合字符）
# 生成示例：openssl rand -base64 24 | tr -dc 'A-Za-z0-9' | head -c 24
MYSQL_PASSWORD=your_secure_password_here_min_16_chars
MYSQL_USER=moyuyo
MYSQL_HOST=localhost
MYSQL_PORT=3306
# MySQL TLS：生产环境默认校验证书，需将 CA truststore 挂载到 /opt/mysql-certs/mysql-ca.p12
MYSQL_VERIFY_SERVER_CERTIFICATE=true
# 宿主机上的 MySQL CA PKCS12 信任库，Compose 会只读挂载到应用容器
# 该文件需由 scripts/init-mysql-truststore.sh 生成，且必须先存在再启动容器
MYSQL_TRUSTSTORE_PATH=/opt/moyuyo/certs/mysql-ca.p12
MYSQL_TRUSTSTORE_URL=file:/opt/mysql-certs/mysql-ca.p12
# MySQL truststore 密码：必须使用 scripts/init-mysql-truststore.sh 生成的强随机值
# 必须 ≥ 8 位且非 changeit/your_xxx 占位符，否则 ProdConfigValidator 直接阻断启动
# 生成示例：openssl rand -base64 24 | tr -dc 'A-Za-z0-9' | head -c 24
MYSQL_TRUSTSTORE_PASSWORD=REPLACE_WITH_RANDOM_TRUSTSTORE_PASSWORD_MIN_8_CHARS

# ---- Redis ----
# Redis 密码（如无密码则留空，但生产环境强烈建议设置）
REDIS_PASSWORD=your_redis_password_here
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- mysqld_exporter 监控账号（仅本机 Prometheus 使用）----
# 生产环境建议创建一个权限最小化的监控账号：
#   CREATE USER 'exporter'@'%' IDENTIFIED BY '<此密码>';
#   GRANT PROCESS, REPLICATION CLIENT, SELECT ON *.* TO 'exporter'@'%';
#   FLUSH PRIVILEGES;
# 禁止使用 root 账号，避免 exporter 被入侵后提权
# ProdConfigValidator 强制要求 ≥ 16 位且不与 MYSQL_PASSWORD 复用
MYSQL_EXPORTER_PASSWORD=your_mysql_exporter_password_min_16_chars_random

# ---- redis_exporter 监控账号（仅本机 Prometheus 使用）----
# redis_exporter 通常使用与 Redis 本身相同的密码即可（Exporter 走全命令读权限），
# 但若希望最小权限，可创建独立只读账号（Redis 6+ 支持 ACL）：
#   ACL SETUSER exporter on '>redis_exporter_pwd' ~* +@read -@write
# ProdConfigValidator 强制要求 ≥ 8 位且不与 REDIS_PASSWORD 复用
REDIS_EXPORTER_PASSWORD=your_redis_exporter_password_min_8_chars_random

# ---- JWT ----
# JWT 签名密钥（生产环境必填，建议 32+ 字节随机字符串）
# 生成命令：openssl rand -base64 48
JWT_SECRET=your_jwt_secret_key_at_least_32_chars_long_random

# ---- API 签名 ----
# API 请求签名密钥（生产环境启用签名时必填，对应 api.signature.secret）
# 用于对所有写接口（订单/支付/退款等）做 HMAC-SHA256 签名校验，防止伪造请求
# 生成命令：openssl rand -base64 32
# 默认关闭签名（API_SIGNATURE_ENABLED=false），客户端 SDK 未实现签名时开启会阻断所有写请求
# 启用前请确认前端 SDK 已实现签名：每个写请求带 X-Sign/X-Timestamp/X-Nonce 三头
API_SIGNATURE_ENABLED=false
API_SIGN_SECRET=your_api_sign_secret_at_least_32_chars_long_random

# ---- 支付渠道 ----
# Stripe（生产环境必填，从 https://dashboard.stripe.com/apikeys 获取）
STRIPE_SECRET_KEY=sk_live_your_stripe_key
# Stripe Publishable Key：传给前端用于 Stripe.js / Apple Pay / Google Pay SDK；如使用 Checkout Session 可留空
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# PayPal（生产环境必填）
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id
# PayPal 回调域名白名单，多个用逗号分隔，防止开放重定向
# 注意：必须包含支付中转页所在的后端域名（默认 https://api.moyuyo.com），否则 PayPal 创建订单时会拒绝 returnUrl
PAYPAL_ALLOWED_ORIGINS=https://moyuyo.com,https://api.moyuyo.com

# ---- WooCommerce ----
WOOCOMMERCE_URL=https://your-woocommerce-store.com
WOOCOMMERCE_CONSUMER_KEY=your_consumer_key
WOOCOMMERCE_CONSUMER_SECRET=your_consumer_secret

# ---- 管理员账号（生产环境必填） ----
# 用户名不能使用 admin / root / administrator 等弱用户名（OWASP 黑名单，会被 AdminInitializer 拒绝）
# 留空时启动会因无超管账号被阻断（ProdConfigValidator + AdminInitializer 双重保护）
ADMIN_USERNAME=moyuyo_admin
# 管理员邮箱（必须合法，符合 RFC 5322 简单格式）
ADMIN_EMAIL=admin@moyuyo.com
# 管理员密码：至少 12 位，包含大小写+数字+特殊字符，且不得包含"ChangeThisPassword"等示例占位符（ProdConfigValidator 会在启动期直接阻断）
# 推荐生成：openssl rand -base64 16
# 占位符使用不会被误判为示例值的随机字符串，便于复制后立即找到所有需替换项
ADMIN_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD_AT_LEAST_12_CHARS

# ---- CORS ----
# CORS 允许的来源域名（逗号分隔，生产环境必填，禁止使用 *）
# 示例: MOYUYO_CORS_ORIGINS=https://admin.moyuyo.com,https://www.moyuyo.com
MOYUYO_CORS_ORIGINS=https://admin.example.com,https://www.example.com

# ---- Elasticsearch ----
# 生产环境必须使用 HTTPS + x-pack security 认证
# 示例：ELASTICSEARCH_URIS=https://es-node1.moyuyo.internal:9200,https://es-node2.moyuyo.internal:9200
ELASTICSEARCH_URIS=https://es-node1.moyuyo.internal:9200,https://es-node2.moyuyo.internal:9200,https://es-node3.moyuyo.internal:9200
ELASTICSEARCH_USERNAME=elastic
# ES 内置 elastic 账号密码：必须使用 openssl rand -base64 24 | tr -dc 'A-Za-z0-9' | head -c 24 生成的强随机值
# ⚠️ 严禁留空或保留为 your_xxx 占位符！ProdConfigValidator 会在启动期直接阻断启动
ELASTICSEARCH_PASSWORD=your_elasticsearch_password_min_16_chars_random
# HTTPS 与证书校验
ELASTICSEARCH_SSL_ENABLED=true
ELASTICSEARCH_SSL_CERT_VALIDATION=true
# 可选：自定义 CA/Server 证书（不设置时使用 JVM truststore）
# ELASTICSEARCH_SSL_BUNDLE=/etc/ssl/moyuyo-ca.p12
# 信任库解锁密码（必须与 ES 节点 elasticsearch.p12 生成时设置的密码一致）
# 必须 ≥ 8 位且非 changeit/your_xxx 占位符，否则 ProdConfigValidator 直接阻断启动
# 生成示例：openssl rand -base64 24 | tr -dc 'A-Za-z0-9' | head -c 24
ELASTICSEARCH_TRUSTSTORE_PASSWORD=REPLACE_WITH_RANDOM_ES_TRUSTSTORE_PASSWORD_MIN_8_CHARS
# SSL Bundle 密码（与 truststore 保持一致）
# 注：当前应用未启用 Spring Boot 的 SSL Bundle 机制（ES 客户端通过 truststore 走校验），
#     此变量保留仅为 docker-compose 中 JAVA_TOOL_OPTIONS -Djavax.net.ssl.trustStore 兼容性。
#     ProdConfigValidator 当前不校验此字段；如未来切换到 SSL Bundle 模式再补 REQUIRED 校验
ELASTICSEARCH_SSL_BUNDLE_PASSWORD=REPLACE_WITH_RANDOM_ES_BUNDLE_PASSWORD_MIN_8_CHARS

# ---- RocketMQ ----
ROCKETMQ_NAMESRV_ADDR=localhost:9876

# ---- JVM 参数（Docker 部署） ----
# 启用 ES 后建议增大堆内存（ES 客户端 / 索引构建需要更多堆）
JVM_XMS=1g
JVM_XMX=2g

# ---- HTTP 客户端超时（下游 API 调用） ----
# 连接建立超时（毫秒）
MOYUYO_HTTP_CONNECT_TIMEOUT_MS=5000
# 响应读取超时（毫秒）
MOYUYO_HTTP_READ_TIMEOUT_MS=15000

# ---- 链路追踪采样率（0.0 ~ 1.0） ----
# dev 环境默认为 1.0（100%），prod 默认 0.1（10%）；按后端处理能力调整
# 设置过低会丢失故障链路，过高会增加 Zipkin/Jaeger 后端压力
# MOYUYO_TRACE_SAMPLE_RATE=0.1

# ---- 审计日志保留期 ----
# 操作审计日志保留天数，超过该天数的历史数据将被定时清理（默认 90 天，GDPR 合规推荐值）
# 分区表走 DROP PARTITION（O(1)）；非分区表走 DELETE WHERE
# MOYUYO_AUDIT_RETENTION_DAYS=90
# 是否启用定时清理（true/false，默认 true；关闭后由 DBA 手动维护）
# MOYUYO_AUDIT_RETENTION_ENABLED=true

# ---- BCrypt 强度 ----
# 密码哈希强度（cost factor），范围 4~31，OWASP 推荐 ≥ 10
# 默认 12（每用户登录/注册约 250ms/次）
# 调高会显著增加 CPU 成本（cost=14 约 1s/次），但安全强度倍增
# 调低可降低 CPU 峰值但抗暴力破解能力下降
# MOYUYO_BCRYPT_STRENGTH=12

# ---- OpenAPI 文档元数据 ----
# 团队联系邮箱（生产环境必填，不可注释/留空）：ProdConfigValidator 启动期校验，
# 强制使用公司自有域名，禁止使用 example.com/your-company.example.com 等占位符
# 缺失或使用示例域名会直接阻断启动
OPENAPI_CONTACT_EMAIL=backend@moyuyo.com
# OpenAPI 文档版本号（生产环境必填）：用于 OpenAPI 文档元数据，
# 由 CI/CD 通过 MOYUYO_BUILD_VERSION 注入，覆盖默认 1.0.0 占位
# OPENAPI_VERSION=1.0.0
# 注入到 Swagger UI 的服务器列表（逗号分隔 "url|description"），便于联调时切换目标
# 未配置时仅显示本地开发地址。生产环境 springdoc.api-docs.enabled=false 会自动屏蔽这些。
# OPENAPI_SERVERS=https://api-staging.moyuyo.com|Staging,https://api.moyuyo.com|生产环境
# License URL（可选）：在 OpenAPI 文档 info.license 节点附加 Proprietary 链接，便于合规审计与品牌露出
# 仅当该值非空时才会附加到 OpenAPI 文档（与 contact-email 解耦，便于独立开关）
# OPENAPI_LICENSE_URL=https://moyuyo.com/license

# ---- 限流开关（独立控制 IP / 用户维度） ----
# IP 维度限流：保护登录/支付等未鉴权端点，默认 60 次/分钟/IP
MOYUYO_IP_RATELIMIT_ENABLED=true
# 用户维度限流：保护已鉴权接口，默认开启；与 IP 限流开关解耦，便于按需单独禁用
MOYUYO_USER_RATELIMIT_ENABLED=true

# ---- 审计日志队列容量（OperationLogAspect 异步队列） ----
# 默认 10000 条（约 5MB 堆占用），可按业务吞吐调整（合法范围 1000~100000）
# 调整原因：
#   - 写入慢 / DB 抖动导致队列堆积时，可临时调高避免丢审计
#   - 内存吃紧时调低以释放堆
# 超出会被 OperationLogAspect @PostConstruct 归一化并 WARN 提示
# MOYUYO_AUDIT_QUEUE_CAPACITY=10000
# 队列满时是否阻塞业务（默认 false：fail-open 仅丢审计；true 则抛异常让 5xx 返回）
# MOYUYO_AUDIT_BLOCK_ON_FULL=false

# ---- dev 环境跳过超管初始化（仅本地调试使用，prod 必须为空/未设置） ----
# 设置为 true 后，AdminInitializer 在 ADMIN_* 缺失时不再阻断启动（仅本地开发适用）
# 生产环境严禁设置该变量！
# MOYUYO_SKIP_ADMIN_INIT=true

# ---- CSP（Content-Security-Policy）白名单 ----
# 逗号分隔多个源。运维新增支付 / 监控域名时仅需修改此处，无需重新打包
# 注意：值含 "https://" 等特殊字符时建议用双引号包裹整个值，避免 docker-compose 解析异常
# MOYUYO_SECURITY_CSP_CONNECT_SRC=https://api.stripe.com,https://api-m.paypal.com,https://*.sentry.io
# MOYUYO_SECURITY_CSP_IMG_SRC=data:,https://*.moyuyo.com
# MOYUYO_SECURITY_CSP_FONT_SRC=data:

# ---- 物流轨迹 API（可选，未配置时仅人工维护轨迹） ----
# provider 取值：
#   none       - 默认，本地占位，仅人工维护轨迹
#   mock       - 测试 Mock（仅 DEV/TEST），按运单号前缀返回不同场景数据：
#                 MOCK-DELIVERED-XXX  → 已签收（5 节点轨迹）
#                 MOCK-INTRANSIT-XXX  → 运输中（3 节点轨迹）
#                 MOCK-PENDING-XXX   → 仅发货（1 节点轨迹）
#                 MOCK-EMPTY-XXX      → 空轨迹（触发兜底 DB.traces）
#                 MOCK-ERROR-XXX      → 抛异常（触发异常兜底）
#                 MOCK-REJECTED-XXX   → 未注册（触发自动注册流程）
#                 其他                → 默认运输中场景
#   17track    - 17TRACK V1 API（需配置 api-key）
#   kuaidi100  - 快递100 API（需配置 api-key + customer）
#   aftership  - AfterShip API（需配置 api-key）
# 未启用时 LogisticsServiceImpl 走 NoopLogisticsTrackProvider，物流弹窗只显示人工录入的轨迹
MOYUYO_LOGISTICS_PROVIDER=none
# API 密钥（17TRACK: https://api.17track.net/ 注册获取；aftership: https://admin.aftership.com 获取）
MOYUYO_LOGISTICS_API_KEY=your_logistics_api_key_here
# 快递100 customer id（仅 provider=kuaidi100 时必填，其他提供商留空）
# 获取方式：https://www.kuaidi100.com/openapi/applyinfo.shtml
MOYUYO_LOGISTICS_CUSTOMER=your_kuaidi100_customer_id
# 轨迹拉取间隔（分钟）：定时任务轮询未签收运单的周期
# dev 默认 30 分钟；prod 默认 60 分钟（避免高频调用撑爆第三方配额）
MOYUYO_LOGISTICS_POLL_INTERVAL=30
# 单次拉取最大运单数（防批量调用撑爆配额）
MOYUYO_LOGISTICS_POLL_BATCH_SIZE=100
# HTTP 请求超时（毫秒）
MOYUYO_LOGISTICS_CONNECT_TIMEOUT_MS=5000
MOYUYO_LOGISTICS_READ_TIMEOUT_MS=15000
