# ============================================
# MOYUYO 宠物商城 - 环境变量配置示例
# 复制为 .env 文件并填写实际值
# ============================================

# ---- 数据库 ----
# MySQL 密码（生产环境必填）
MYSQL_PASSWORD=your_secure_password_here
MYSQL_USER=moyuyo
MYSQL_HOST=localhost
MYSQL_PORT=3306

# ---- Redis ----
# Redis 密码（如无密码则留空）
REDIS_PASSWORD=
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- JWT ----
# JWT 签名密钥（生产环境必填，建议 32 位以上随机字符串，可使用 openssl rand -base64 32 生成）
JWT_SECRET=your_jwt_secret_key_at_least_32_chars_long

# ---- API 签名 ----
# API 请求签名密钥（可选，对应 api.signature.secret）
API_SIGN_SECRET=

# ---- 支付渠道 ----
# Stripe（生产环境必填）
STRIPE_SECRET_KEY=sk_live_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# PayPal（生产环境必填）
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id
# PayPal 回调域名白名单，多个用逗号分隔，防止开放重定向
PAYPAL_ALLOWED_ORIGINS=https://moyuyo.com

# ---- WooCommerce ----
WOOCOMMERCE_URL=https://your-woocommerce-store.com
WOOCOMMERCE_CONSUMER_KEY=your_consumer_key
WOOCOMMERCE_CONSUMER_SECRET=your_consumer_secret

# ---- 管理员账号（生产环境必填） ----
# 用户名不能使用 admin / root / administrator 等弱用户名（OWASP 黑名单，会被 AdminInitializer 拒绝）
ADMIN_USERNAME=moyuyo_admin
ADMIN_EMAIL=admin@moyuyo.com
ADMIN_PASSWORD=your_secure_admin_password_at_least_12_chars

# ---- CORS ----
# CORS 允许的来源域名（逗号分隔，生产环境必填，禁止使用 *）
# 示例: MOYUYO_CORS_ORIGINS=https://admin.moyuyo.com,https://www.moyuyo.com
MOYUYO_CORS_ORIGINS=https://admin.example.com,https://www.example.com

# ---- Elasticsearch ----
# 生产环境必须使用 HTTPS + x-pack security 认证
# 示例：ELASTICSEARCH_URIS=https://es-node1.moyuyo.internal:9200,https://es-node2.moyuyo.internal:9200
ELASTICSEARCH_URIS=https://es-node1.moyuyo.internal:9200,https://es-node2.moyuyo.internal:9200,https://es-node3.moyuyo.internal:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=your_elastic_password_here
# HTTPS 与证书校验
ELASTICSEARCH_SSL_ENABLED=true
ELASTICSEARCH_SSL_CERT_VALIDATION=true
# 可选：自定义 CA/Server 证书（不设置时使用 JVM truststore）
# ELASTICSEARCH_SSL_BUNDLE=/etc/ssl/moyuyo-ca.p12
# 信任库解锁密码（必须与生成证书时设置的密码一致，docker-compose 默认使用 changeit）
ELASTICSEARCH_TRUSTSTORE_PASSWORD=changeit
# SSL Bundle 密码（与 truststore 保持一致）
ELASTICSEARCH_SSL_BUNDLE_PASSWORD=changeit

# ---- RocketMQ ----
ROCKETMQ_NAMESRV_ADDR=localhost:9876

# ---- JVM 参数（Docker 部署） ----
# 启用 ES 后建议增大堆内存（ES 客户端 / 索引构建需要更多堆）
JVM_XMS=1g
JVM_XMX=2g
