# ============================================================
# MOYUYO ATELIER - Spring Boot 开发环境快速启动配置
# 本文件用于本地「moyuyo-server」启动；生产部署请使用：
#   moyuyo-server/.env.example 或 docs/deploy/.env.example（含安全校验规则）
# ============================================================
# 安全警告：
#   1. 本文件含敏感凭证，已在 .gitignore 中排除，禁止提交到 Git
#   2. 所有 *PASSWORD / SECRET / KEY 已自动生成强随机值，长度满足应用校验器要求
#   3. 上线生产前：
#        - MYSQL_USER 必须从 root 改为专用账户（推荐 moyuyo，见 .env.example）
#        - 所有 *_PASSWORD / *_SECRET 必须重新生成一套生产专属值（不能沿用 dev）
#        - MOYUYO_CORS_ORIGINS 必须替换为真实线上域名，禁止保留 localhost/*
# ============================================================

# ===== MySQL（本地开发默认 root；如果本机 MySQL 设了 root 密码，请把下方密码同步改一下）=====
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
# 生成方式：powershell: -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 24 | %{[char]$_})
MYSQL_PASSWORD=Tk9q3Lvxf7sBAmR48EYW2gHc

# ===== Redis（本地默认 127.0.0.1:6379，无密码也能跑；但已填入独立密码避免裸奔） =====
# 若你的本地 Redis 启动时未 requirepass，删掉下方 REDIS_PASSWORD 值即可。
REDIS_HOST=localhost
REDIS_PORT=6379
# 长度 ≥ 8；不要与 MYSQL_PASSWORD 相同（ProdConfigValidator 会在 prod 下直接阻断）
REDIS_PASSWORD=Qe2FpS6wXkB8

# ===== JWT 签名密钥（长度 ≥ 32 字符） =====
# 开发默认使用此值；生产务必用 `openssl rand -base64 48` 重新生成
JWT_SECRET=7fXqD8Kb4ZtLs2YwN9pRhCmV3jAeUoQgFnTc1Ixd5Gr6ByHS

# ===== API 请求 HMAC-SHA256 签名密钥（长度 ≥ 32 字符，对应 API_SIGN_SECRET） =====
# 默认签名总开关关闭（API_SIGNATURE_ENABLED=false），此处预填以便后续一键开启
API_SIGN_SECRET=P4mZc8QsWvTkYxHjLnRd2AbXfGpV9yUo

# ===== Stripe 支付（本地默认 Stripe TEST 模式，不是 placeholder 占位符） =====
# ⚠️ 真实接入前，必须去 https://dashboard.stripe.com/test/apikeys 复制你自己的测试密钥覆盖下方两行
#   现在填的是 Stripe 官方公开的永久占位测试 Key（sk_test_4eC39...），仅保证程序不因为空值报错，
#   支付操作会进入 Stripe 沙箱但无法收到你自己商户台的回调。
STRIPE_SECRET_KEY=sk_test_4eC39HqLyjWDarjtT1zdp7dc
# Stripe 测试 Webhook 签名：用 stripe-cli `stripe listen --forward-to localhost:8080/payments/stripe/webhook`
#   启动后会打印 whsec_... 那个值，覆盖下方。此处先填一段合法格式字符串避免 spring 启动报错。
STRIPE_WEBHOOK_SECRET=whsec_dev_local_replace_with_stripe_cli_output_M4c9P2kL

# ===== PayPal（默认 sandbox。上线前必须替换为你自己 PayPal Developer Console 的真实值） =====
# PAYPAL_MODE=sandbox 未显式写在此处时，application-*.yml 默认为 sandbox。
PAYPAL_CLIENT_ID=AU9E_localdev_sandbox_clientid_replace_with_paypal_console
PAYPAL_CLIENT_SECRET=EFX8_localdev_sandbox_secret_replace_with_paypal_console
# 创建 webhook 后从 PayPal Developer Console 拿 Webhook ID（WH-xxx-xxx-xxx）
PAYPAL_WEBHOOK_ID=WH-0000000000-0000000-REPLACE-ME
# 允许的 return_url / cancel_url 来源（PayPal 安全校验）；本地调试也加入 localhost 家族
PAYPAL_ALLOWED_ORIGINS=https://moyuyo.com,http://localhost:5174,http://127.0.0.1:5174

# ===== WooCommerce（可选；自研商城链路不依赖，保留占位也不会阻塞登录/注册） =====
WOOCOMMERCE_URL=http://localhost
WOOCOMMERCE_CONSUMER_KEY=ck_placeholder
WOOCOMMERCE_CONSUMER_SECRET=cs_placeholder

# ===== 管理后台超管初始化（开发用，与项目说明.md 的测试账号密码一致） =====
ADMIN_EMAIL=admin@moyuyo.com
ADMIN_PASSWORD=moyuyo_Dev#2026!

# ===== CORS 允许来源：追加本机 Vite dev 服务器 5173/5174 双端口 + 回环 IP + 常用内网 IP 段占位 =====
# ⚠️ 生产部署必须把 localhost/* 全部去掉，仅保留 https://www.moyuyo.com,https://moyuyo.com 等自有域名
MOYUYO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://192.168.6.103:5174

# ===== Elasticsearch / RocketMQ（可选组件；未部署时使用默认占位） =====
ELASTICSEARCH_URIS=http://localhost:9200
ROCKETMQ_NAMESRV_ADDR=localhost:9876
